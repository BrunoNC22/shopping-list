{
  "name": "shopping-list",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start:api": "npm run start -w api",
    "start:web": "npm run start -w web",

    "dev:web": "npm run dev -w web",
    "dev:api": "npm run dev -w api",
    "dev:domain": "npm run dev -w @shopping-list/domain",

    "build:domain": "npm run build -w @shopping-list/domain",
    "build:web": "npm run build -w web",
    "build:api": "npm run build -w api",

    "build": "npm run build:domain && npm run build:web && npm run build:api",

    "test": "npm run test --workspaces",

    "lint": "eslint ."
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "eslint": "^9.33.0",
    "@eslint/js": "^9.33.0",
    "typescript-eslint": "^8.39.1"
  }
}